# Секретный ключ Flask — сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Порт приложения
APP_PORT=5000

# Серверная авторизация (401/403). 0 — демо-режим без проверки сессии.
# Включайте 1 для любого стенда, доступного не только с localhost.
AUTH_REQUIRED=0

# Разрешённые CORS-origin через запятую. Пусто — только same-origin.
# Пример: https://intravia.example.com
CORS_ORIGINS=

# Secure-cookie (только для HTTPS)
SESSION_COOKIE_SECURE=0

# Включить нейросеть
LLM_ENABLED=1

# Модель нейросети Ollama
LLM_MODEL=qwen2.5:3b

# Модель распознавания голоса
WHISPER_MODEL=small
